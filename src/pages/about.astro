---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About">
  <div class="max-w-2xl mx-auto">

    <div class="bg-blue-50 border border-blue-100 rounded-xl p-8">
      <img
        src="/images/alqadir-logo.jpeg"
        alt="Al-Qadir University Project Trust logo"
        class="h-24 mb-6"
      />
      <h1 class="text-4xl font-bold mb-6 text-blue-950">About the Department</h1>
      <div class="prose prose-slate max-w-none space-y-4 text-lg">
        <p>
          The Department of Computer Science at Al-Qadir University Project
          Trust offers a BS in Computer Science built around a thesis-driven
          final semester, giving students hands-on research experience before
          graduation. The program recently completed NCEAC accreditation,
          Pakistan's national accreditation standard for computing programs.
        </p>
        <p>
          The department emphasizes applied, industry-relevant computer
          science -- data science, software engineering, and AI -- taught by
          faculty who bring direct industry and cross-sector experience into
          the classroom.
        </p>
      </div>
    </div>

  </div>
</Layout>
