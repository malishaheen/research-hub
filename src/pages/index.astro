---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const sorted = allNotes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryStyles: Record<string, string> = {
  cs: 'bg-indigo-100 text-indigo-700',
  'data-science': 'bg-emerald-100 text-emerald-700',
  management: 'bg-amber-100 text-amber-700',
};
---
<Layout title="Research Hub">
  <h1 class="text-4xl font-extrabold tracking-tight mb-2">Al-Qadir's Research Portal</h1>
  <p class="text-slate-600 mb-6">Research, notes, and tools from the Al-Qadir University Project Trust community.</p>

  <div class="ticker-wrap bg-slate-900 text-slate-100 rounded-lg mb-10 flex items-center">
    <span class="flex-shrink-0 flex items-center gap-1.5 px-3 py-2 text-xs font-bold uppercase tracking-wide bg-red-600 rounded-l-lg">
      <span class="w-1.5 h-1.5 bg-white rounded-full animate-pulse"></span>
      Live
    </span>
    <div class="ticker-track px-4 py-2 text-sm" id="tickerTrack">Loading tech headlines…</div>
  </div>

  <div class="bg-gradient-to-br from-indigo-50 to-white border border-indigo-100 rounded-2xl p-6 mb-12 flex items-center gap-6 shadow-sm">
    <img
      src="/images/alqadir-logo.jpeg"
      alt="Al-Qadir University Project Trust logo"
      class="h-16 w-16 object-contain flex-shrink-0 rounded-lg"
    />
    <div>
      <h2 class="text-xl font-bold text-indigo-950 mb-1">Department of Computer Science</h2>
      <p class="text-slate-700">
        NCEAC-accredited BS in Computer Science with a thesis-driven final
        semester, applied research focus, and faculty bringing real
        industry experience into the classroom.
        <a href="/about" class="text-indigo-600 hover:text-indigo-800 hover:underline font-medium">Learn more →</a>
      </p>
    </div>
  </div>

  <h2 class="text-2xl font-bold mb-8">Latest Updates</h2>
  <ul class="space-y-4">
    {sorted.map(note => (
      <li class="border border-slate-200 rounded-xl p-6 hover:border-indigo-300 hover:shadow-md transition-all bg-white">
        <a href={`/notes/${note.id}`} class="text-lg font-semibold text-slate-900 hover:text-indigo-700">
          {note.data.title}
        </a>
        <div class="flex items-center gap-2 mt-2">
          <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${categoryStyles[note.data.category] ?? 'bg-slate-100 text-slate-700'}`}>
            {note.data.category}
          </span>
          <span class="text-sm text-slate-500">{note.data.date.toDateString()}</span>
        </div>
        <p class="text-slate-700 mt-3">{note.data.summary}</p>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .ticker-wrap {
    overflow: hidden;
    white-space: nowrap;
  }
  .ticker-track {
    display: inline-block;
    white-space: nowrap;
  }
  .ticker-track.scrolling {
    animation: ticker-scroll 45s linear infinite;
  }
  .ticker-track.scrolling:hover {
    animation-play-state: paused;
  }
  @keyframes ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .ticker-item {
    display: inline-block;
    margin-right: 2.5rem;
    color: inherit;
    text-decoration: none;
  }
  .ticker-item:hover {
    text-decoration: underline;
  }
  .ticker-sep {
    margin-right: 2.5rem;
    color: #64748b;
  }
</style>

<script>
  async function loadTicker() {
    const el = document.getElementById('tickerTrack');
    if (!el) return;
    try {
      const idsRes = await fetch('https://hacker-news.firebaseio.com/v0/topstories.json');
      const ids = await idsRes.json();
      const top = ids.slice(0, 8);
      const stories = await Promise.all(
        top.map((id: number) =>
          fetch(`https://hacker-news.firebaseio.com/v0/item/${id}.json`).then(r => r.json())
        )
      );
      const items = stories
        .filter(s => s && s.title)
        .map(s => {
          const url = s.url || `https://news.ycombinator.com/item?id=${s.id}`;
          return `<a href="${url}" target="_blank" rel="noopener" class="ticker-item">${s.title}</a>`;
        })
        .join('<span class="ticker-sep">•</span>');
      el.innerHTML = items + '<span class="ticker-sep">•</span>' + items;
      el.classList.add('scrolling');
    } catch (e) {
      el.textContent = 'Live headlines unavailable right now — check back later.';
    }
  }
  loadTicker();
</script>